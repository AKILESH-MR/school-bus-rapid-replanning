# School Bus Rapid Replanning — Environment Configuration
# Copy this file to .env and fill in your values.
# The server selects the database backend based on DB_BACKEND.

# --------------------------------------------------------------------------
# Database Backend Selection
# --------------------------------------------------------------------------
# DB_BACKEND=postgres   → Use PostgreSQL (requires PG_* vars below)
# DB_BACKEND=sqlite     → Use Node.js built-in SQLite (default / fallback)
DB_BACKEND=sqlite

# --------------------------------------------------------------------------
# PostgreSQL Connection (required when DB_BACKEND=postgres)
# --------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=school_bus_replanning
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL=false
# PG_SSL=true          → Enable for hosted / cloud PostgreSQL

# Connection pool settings (optional — sensible defaults shown)
PG_POOL_MIN=2
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
